# Production settings for the backend server, for the doctors' trial.
# On the server: copy this file to .env, fill in every line marked <-- CHANGE, then run  php artisan key:generate
# The website itself is hosted on Netlify; this server (https://svu.dallal-syria.site) only runs the API.
# See DEPLOY_FRONTEND.txt.

APP_NAME="SVU Faculty Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The backend's own public address, with https:// and no slash at the end.
APP_URL=https://svu.dallal-syria.site

# The website on Netlify. Only this address may call the API from a browser.
FRONTEND_URL=https://imaginative-donut-ae758b.netlify.app

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
BUSINESS_TIMEZONE=Asia/Damascus

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=svu_portal
DB_USERNAME=svu                                                  # <-- CHANGE (the database user you created)
DB_PASSWORD=choose-a-strong-password                             # <-- CHANGE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# Leave empty. The Netlify website signs in with tokens; listing its address here would break sign-in.
SANCTUM_STATEFUL_DOMAINS=

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Keep "log" for the trial: the demo students have realistic @svuonline.org addresses, so real sending
# could reach real mailboxes. Messages are written to storage/logs/laravel.log instead.
MAIL_MAILER=log
# While MAIL_MAILER=log nothing is sent, so this address only appears as "From" in the log and does not have to
# exist. It matters only when real sending is switched on later (it must then belong to a verified domain).
MAIL_FROM_ADDRESS=no-reply@dallal-syria.site
MAIL_FROM_NAME="SVU Faculty Portal"

# Doctors' trial: instant sign-up (any @svuonline.org address) with private demo classes per doctor.
PORTAL_SIGNUP_INSTANT=true
PORTAL_SHARE_COURSE_FILES=false

# Password of the demo accounts created by  php artisan db:seed --force  (t_samer, t_mona, m_bit, m_mws, admin).
# Seeding refuses to run on this server until it is changed from the public test password.
SEED_PASSWORD=Password123!
